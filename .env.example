# 环境变量模板：复制成 .env 后填入真实值
#
#   cp .env.example .env      （Windows: copy .env.example .env）
#
# ⚠️ .env 已被 .gitignore 排除，**不要**把它提交进仓库、贴到聊天里或写进文档。
#    本文件（.env.example）不含任何真实密钥，用于说明需要哪些变量。

# ── 真实模型评测（云端 API）──────────────────────────────────────────
# 只用于「质量评测」，不要用它做并发压测（延迟含公网、还会撞限流）。
DEEPSEEK_API_KEY=
# 可选：覆盖默认值（默认 https://api.deepseek.com，模型 deepseek-flash）
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# 想省钱的建议：
#   1) 平台余额只充小额（例如 10 元），评测套餐本身约 2 元；
#   2) 跑完评测后到控制台**吊销/轮换**该 key；
#   3) 优先在 off-peak 时段跑（价格为 peak 的一半）。

# ── 服务层（agent/service）──────────────────────────────────────────
# SERVICE_DATABASE_URL=sqlite:///./agent_service.db
# SERVICE_KV_BACKEND=memory            # memory | redis
# SERVICE_REDIS_URL=redis://127.0.0.1:6379/0
# SERVICE_JWT_SECRET=change-me-to-a-long-random-string
# SERVICE_AUTH_REQUIRED=1
# SERVICE_DEV_TOKEN=0                  # 生产必须关闭开发令牌接口
# SERVICE_LLM_BACKEND=planner          # planner | streaming | openai
# SERVICE_LLM_BASE_URL=
# SERVICE_LLM_MODEL=
# SERVICE_RATE_LIMIT_CAPACITY=20
# SERVICE_RATE_LIMIT_REFILL_PER_SEC=2
# SERVICE_QUOTA_TOKENS_PER_DAY=200000

# ── 知识库路径（可选）────────────────────────────────────────────────
# AGENT_KB_PATH=eval/fixtures/mini_corpus.jsonl
